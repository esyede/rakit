<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

use System\Auth;
use System\Config;

$check = false;
$user = null;
$err = null;

try {
    $check = Auth::check();
    $user = $check ? Auth::user() : null;
} catch (\Throwable $e) {
    $err = $e->getMessage();
} catch (\Exception $e) {
    $err = $e->getMessage();
}

$driver = Config::get('auth.driver', 'magic');
$table = Config::get('auth.table', 'users');
$username = Config::get('auth.username', 'email');

// List of sensitive fields.
$sensitive = [
  '2fa',
  '2fa_code',
  '2fa_pin',
  '2fa_token',
  '_csrf',
  'acc_number',
  'access_token',
  'account_bank_number',
  'account_number',
  'account_routing_number',
  'api_key',
  'api_token',
  'auth_token',
  'bank_acc',
  'bank_acc_num',
  'bank_acc_number',
  'bank_account',
  'bank_account_num',
  'bank_account_number',
  'card_cvv',
  'card_num',
  'card_number',
  'cc_num',
  'cc_number',
  'cert',
  'certificate',
  'confirm_passwd',
  'confirm_password',
  'credentials',
  'credit_card',
  'credit_card_num',
  'credit_card_number',
  'creds',
  'csrf',
  'cvv',
  'dsn',
  'issuer_certificate',
  'key',
  'mysql_pwd',
  'new_password',
  'old_password',
  'otp',
  'otp_code',
  'otp_pin',
  'otp_token',
  'passwd',
  'passwd_confirm',
  'password',
  'password1',
  'password2',
  'password_confirm',
  'pin',
  'private_key',
  'pwd',
  'raw',
  'repeat_password',
  'routing_acc',
  'routing_acc_num',
  'routing_acc_number',
  'routing_account_number',
  'routing_number',
  'salt',
  'secret',
  'security_code',
  'security_pin',
  'security_token',
  'social_security_num',
  'social_security_number',
  'ssn',
  'stripe_token',
  'token',
  'totp',
  'totp_code',
  'totp_pin',
  'totp_token',
  'two_factor_code',
  'two_factor_pin',
  'two_factor_token',
];

$isSensitive = function ($key) use ($sensitive) {
    $key = strtolower((string) $key);
    foreach ($sensitive as $s) {
        if (false !== strpos($key, $s)) {
            return true;
        }
    }
    return false;
};

$fields = [];
if (is_object($user)) {
    $fields = get_object_vars($user);
} elseif (is_array($user)) {
    $fields = $user;
}
?>
<style class="oops-debug">
    #oops-debug .oops-AuthPanel td:first-child {
        font-weight: bold;
        width: 28%;
        white-space: nowrap;
        vertical-align: top;
    }

    #oops-debug .oops-AuthPanel .oops-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 11px;
        font-weight: bold;
        color: #fff;
    }

    #oops-debug .oops-AuthPanel .oops-badge-on {
        background: #4CAF50;
    }

    #oops-debug .oops-AuthPanel .oops-badge-off {
        background: #9E9E9E;
    }

    #oops-debug .oops-AuthPanel .oops-mask {
        color: #999;
        font-style: italic;
    }

    #oops-debug .oops-AuthPanel pre {
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

<h1>Auth</h1>

<div class="oops-inner oops-AuthPanel">
    <div class="oops-inner-container">
        <?php if ($err !== null) : ?>
            <p class="oops-empty">Auth tidak tersedia: <?php echo Helpers::escapeHtml($err); ?></p>
        <?php endif; ?>

        <table>
            <tr>
                <td>Status</td>
                <td>
                    <?php if ($check) : ?>
                        <span class="oops-badge oops-badge-on">Authenticated</span>
                    <?php else : ?>
                        <span class="oops-badge oops-badge-off">Guest</span>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td>Driver</td>
                <td><?php echo Helpers::escapeHtml($driver); ?></td>
            </tr>
            <tr>
                <td>User Table</td>
                <td><?php echo Helpers::escapeHtml($table); ?></td>
            </tr>
            <tr>
                <td>Username Field</td>
                <td><?php echo Helpers::escapeHtml($username); ?></td>
            </tr>
        </table>

        <?php if ($check) : ?>
            <h2>User (<?php echo count($fields); ?> field<?php echo count($fields) !== 1 ? 's' : ''; ?>)</h2>
            <?php if (empty($fields)) : ?>
                <p class="oops-empty">User object has no readable fields</p>
            <?php else : ?>
                <table>
                    <?php foreach ($fields as $key => $value) : ?>
                        <tr>
                            <td><?php echo Helpers::escapeHtml($key); ?></td>
                            <td>
                                <?php if ($isSensitive($key)) : ?>
                                    <span class="oops-mask">•••••••• (masked)</span>
                                <?php elseif (is_scalar($value) || is_null($value)) : ?>
                                    <?php echo Helpers::escapeHtml((string) $value); ?>
                                <?php else : ?>
                                    <?php echo Dumper::toHtml($value); ?>
                                <?php endif; ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </table>
            <?php endif; ?>
        <?php else : ?>
            <p class="oops-empty">No authenticated user (guest request).</p>
        <?php endif; ?>
    </div>
</div>
