<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

use System\Request;
use System\Routing\Route;

$stripDomain = function ($key) {
    $pos = strpos($key, '||');
    return (false !== $pos) ? substr($key, $pos + 2) : $key;
};

$currentMethod = isset($_SERVER['REQUEST_METHOD']) ? $_SERVER['REQUEST_METHOD'] : 'GET';
$currentUri = isset($_SERVER['REQUEST_URI']) ? parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH) : null;
$currentRoute = null;
$matched = Request::route();

if ($matched instanceof Route) {
    $action = $matched->action;
    $name = (is_array($action) && isset($action['as'])) ? $action['as'] : null;

    if (is_array($action) && isset($action['uses'])) {
        $uses = $action['uses'];
    } elseif ($matched->controller) {
        $uses = $matched->controller . '@' . $matched->controller_action;
    } else {
        $uses = 'Closure';
    }

    $currentRoute = [
        'uri' => $stripDomain($matched->uri),
        'method' => $matched->method ? $matched->method : $currentMethod,
        'name' => $name,
        'action' => $uses,
        'controller' => $matched->controller ? $matched->controller : null,
        'parameters' => is_array($matched->parameters) ? array_filter($matched->parameters, 'strlen') : [],
        'filters' => (is_array($action) && isset($action['filters'])) ? $action['filters'] : [],
    ];
} elseif (isset($this->data['current_route'])) {
    $currentRoute = $this->data['current_route'];
}

// Get all registered routes
$allRoutes = [];
$registeredRoutes = Route::lists();
foreach ($registeredRoutes as $method => $routes) {
    foreach ($routes as $uri => $route) {
        $uri = $stripDomain($uri);
        if ($uri !== '(:all)') {
            $allRoutes[] = [
                'method' => $method,
                'uri' => $uri,
                'name' => isset($route['as']) ? $route['as'] : null,
                'action' => $route,
                'https' => isset($route['https']) ? $route['https'] : false,
                'filters' => isset($route['filters']) ? $route['filters'] : [],
            ];
        }
    }
}

// Sort routes by URI
usort($allRoutes, function ($a, $b) {
    return strcmp($a['uri'], $b['uri']);
});

$totalRoutes = count($allRoutes);
?>
