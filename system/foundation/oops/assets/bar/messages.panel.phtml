    }
</style>

<h1>Messages</h1>

<div class="oops-inner oops-MessagesPanel">
    <div class="oops-inner-container oops-filterable">
        <?php if (empty($logs)) : ?>
            <p class="oops-empty">Messages are empty</p>
        <?php else : ?>
            <ul class="oops-msg-list">
                <?php foreach ($logs as $log) :
                    $level = strtolower(isset($log['level']) ? $log['level'] : 'debug');
                    $group = $groupOf($level);
                    $message = isset($log['message']) ? $log['message'] : '';
                    $context = !empty($log['context']) ? print_r($log['context'], true) : '';
                    $file = isset($log['file']) ? $log['file'] : null;
                    $line = isset($log['line']) ? $log['line'] : null;
                    $caller = $file ? (basename($file) . ($line ? '#' . $line : '')) : '';
                    $search = strtolower($level . ' ' . $message . ' ' . $context . ' ' . $caller);
                ?>
                    <li class="oops-msg oops-filter-item oops-msg-g-<?php echo $group ?>" data-oops-tag="<?php echo Helpers::escapeHtml($level) ?>" data-oops-search="<?php echo Helpers::escapeHtml($search) ?>">
                        <?php if ('' !== $caller) : ?>
                            <?php $editUri = Helpers::editorUri($file, $line ? $line : 1); ?>
                            <span class="oops-msg-caller" title="<?php echo Helpers::escapeHtml($file . ($line ? ':' . $line : '')) ?>"><?php if ($editUri) : ?><a href="<?php echo Helpers::escapeHtml($editUri) ?>"><?php echo Helpers::escapeHtml($caller) ?></a><?php else : ?><?php echo Helpers::escapeHtml($caller) ?><?php endif ?></span>
                        <?php endif ?>
                        <span class="oops-msg-level"><?php echo Helpers::escapeHtml($level) ?></span>
                        <span class="oops-msg-value"><?php echo Helpers::escapeHtml($message) ?></span>
                        <?php if ('' !== $context) : ?>
                            <?php echo Dumper::toHtml($log['context']) ?>
                        <?php endif ?>
                    </li>
                <?php endforeach ?>
                <li class="oops-empty oops-filter-empty" style="display: none; list-style: none;">No messages match your filter.</li>
            </ul>

            <div class="oops-toolbar">
                <input type="text" class="oops-filter-input" placeholder="Search messages&hellip;" spellcheck="false" autocomplete="off">
                <span class="oops-filter-tags">
                    <?php foreach ($ordered as $lvl => $c) :
                        $color = isset($levelColors[$lvl]) ? $levelColors[$lvl] : '#757575';
                    ?>
                        <button type="button" class="oops-filter-tag oops-active" data-oops-tag="<?php echo Helpers::escapeHtml($lvl) ?>" style="--oops-tag: <?php echo $color ?>;">
                            <?php echo Helpers::escapeHtml($lvl) ?>
                            <span class="oops-tag-count"><?php echo $c ?></span>
                        </button>
                    <?php endforeach ?>
                </span>
                <span class="oops-filter-count"></span>
            </div>
        <?php endif ?>
    </div>
</div>
