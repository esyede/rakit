<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

$logs = isset($this->data['logs']) ? $this->data['logs'] : [];

$levelColors = [
    'emergency' => '#b71c1c', 'alert' => '#c62828', 'critical' => '#d32f2f',
    'error' => '#e53935', 'warning' => '#f9a825', 'notice' => '#1e88e5',
    'info' => '#43a047', 'debug' => '#757575',
];

// Kelompokkan level untuk pewarnaan teks (gaya laravel-debugbar: error merah,
// warning amber, selebihnya default).
$groupOf = function ($lvl) {
    if (in_array($lvl, ['emergency', 'alert', 'critical', 'error'], true)) {
        return 'error';
    }
    if ('warning' === $lvl) {
        return 'warning';
    }
    return 'other';
};

// Hitung jumlah per level (untuk chip filter) mengikuti urutan $levelColors.
$counts = [];
foreach ($logs as $log) {
    $lvl = strtolower(isset($log['level']) ? $log['level'] : 'debug');
    $counts[$lvl] = (isset($counts[$lvl]) ? $counts[$lvl] : 0) + 1;
}
$ordered = [];
foreach (array_keys($levelColors) as $lvl) {
    if (isset($counts[$lvl])) {
        $ordered[$lvl] = $counts[$lvl];
    }
}
foreach ($counts as $lvl => $c) {
    if (!isset($ordered[$lvl])) {
        $ordered[$lvl] = $c;
    }
}
?>
<style class="oops-debug">
    /* Widget Messages meniru laravel-debugbar: tiap baris = teks pesan (kiri)
       dengan level & caller mengapung ke kanan; toolbar filter menempel di
       BAWAH panel (sticky). */
