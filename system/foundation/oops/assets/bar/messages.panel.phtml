        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-list {
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1 0 auto;
    }

    #oops-debug .oops-MessagesPanel .oops-msg {
        padding: 4px 10px;
        border-bottom: 1px solid #eee;
        overflow: hidden;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-caller,
    #oops-debug .oops-MessagesPanel .oops-msg-level {
        float: right;
        margin-left: 12px;
        font-size: 11px;
        line-height: 1.6;
        white-space: nowrap;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-caller {
        font-family: Menlo, Monaco, Consolas, monospace;
        color: #999;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-caller a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dotted currentColor;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-caller a:hover {
        color: #2563eb;
    }

    #oops-debug.oops-theme-dark .oops-MessagesPanel .oops-msg-caller a:hover {
        color: #7aa2f7;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-level {
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #9aa0a6;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-value {
        display: block;
        font-family: Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
        color: #333;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-g-error .oops-msg-value {
        color: #e53935;
    }

    #oops-debug .oops-MessagesPanel .oops-msg-g-warning .oops-msg-value {
