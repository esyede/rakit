        order: 2;
        position: sticky;
        bottom: -16px;
        z-index: 3;
        box-sizing: border-box;
        width: 100%;
        margin: 0 0 -16px !important;
        padding: 8px 12px;
        border-top: 1px solid #ececec;
        border-bottom: none;
        background: #ffffff;
    }

    /* Mode gelap */
    #oops-debug.oops-theme-dark .oops-MessagesPanel .oops-msg {
        border-bottom-color: #232733;
    }

    #oops-debug.oops-theme-dark .oops-MessagesPanel .oops-msg-value {
        color: #c9ced8;
    }

    #oops-debug.oops-theme-dark .oops-MessagesPanel .oops-msg-g-error .oops-msg-value {
        color: #f8918a;
    }

    #oops-debug.oops-theme-dark .oops-MessagesPanel .oops-msg-g-warning .oops-msg-value {
        color: #ffb570;
