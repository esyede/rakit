<h1>Mails</h1>

<div class="oops-inner oops-MailsPanel">
    <div class="oops-inner-container">
        <?php if (empty($mails)) : ?>
            <p class="oops-empty">No emails were sent</p>
        <?php else : ?>
            <?php foreach ($mails as $i => $mail) :
                $to = isset($mail['to']) ? $mail['to'] : '';
                $cc = isset($mail['cc']) ? $mail['cc'] : '';
                $bcc = isset($mail['bcc']) ? $mail['bcc'] : '';
                $from = isset($mail['from']) ? $mail['from'] : '';
                $subject = isset($mail['subject']) ? $mail['subject'] : '(no subject)';
                $isHtml = !empty($mail['html']);
                $body = isset($mail['body']) ? $mail['body'] : '';
                $headers = isset($mail['headers']) && is_array($mail['headers']) ? $mail['headers'] : [];
                $ref = 'mail-body-' . $i;
            ?>
                <div class="oops-mail">
                    <div class="oops-mail-head">
                        <span class="oops-mail-subject"><?php echo Helpers::escapeHtml($subject) ?></span>
                        <span class="oops-mail-type"><?php echo $isHtml ? 'HTML' : 'Text' ?></span>
                        <span class="oops-mail-addr"><b>To</b> <?php echo Helpers::escapeHtml($to) ?></span>
                        <?php if ('' !== $cc) : ?><span class="oops-mail-addr"><b>Cc</b> <?php echo Helpers::escapeHtml($cc) ?></span><?php endif ?>
                        <?php if ('' !== $bcc) : ?><span class="oops-mail-addr"><b>Bcc</b> <?php echo Helpers::escapeHtml($bcc) ?></span><?php endif ?>
                        <span class="oops-mail-addr"><b>From</b> <?php echo Helpers::escapeHtml($from) ?></span>
                    </div>
                    <p class="oops-mail-toggle"><a class="oops-toggle oops-collapsed" data-oops-ref="^div .<?php echo $ref ?>">Headers &amp; body</a></p>
                    <div class="<?php echo $ref ?> oops-collapsed">
                        <div class="oops-mail-detail">
                            <?php if (!empty($headers)) : ?>
                                <table class="oops-mail-headers">
                                    <?php foreach ($headers as $name => $value) : ?>
                                        <tr>
                                            <td><?php echo Helpers::escapeHtml($name) ?></td>
                                            <td><?php echo Helpers::escapeHtml(is_array($value) ? implode(', ', $value) : $value) ?></td>
                                        </tr>
                                    <?php endforeach ?>
                                </table>
                            <?php endif ?>
                            <pre class="oops-mail-body"><?php echo Helpers::escapeHtml($body) ?></pre>
                        </div>
                    </div>
                </div>
            <?php endforeach ?>
        <?php endif ?>
    </div>
</div>
