<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

$base = Debugger::$time; // == RAKIT_START
$total = (microtime(true) - $base) * 1000; // ms
if ($total <= 0) {
    $total = 1;
}

/*
| Kumpulkan seluruh "measure" dari berbagai collector ke satu timeline
| (meniru laravel-debugbar yang menggabungkan time, db, view, dan event
| pada satu track). Tiap measure punya start-offset (ms dari awal request)
| dan durasi sehingga bisa dipetakan menjadi bar horizontal.
*/
$measures = [];

// 1) Time: fase framework (Booting/Routing/Controller/Render) + measure() manual.
$phaseColors = [
    'Booting' => '#7E57C2',
    'Routing' => '#42A5F5',
    'Controller' => '#26A69A',
    'Render' => '#FFA726',
];
$timers = isset($this->data['timers']) ? $this->data['timers'] : [];
foreach ($timers as $name => $timer) {
    $measures[] = [
        'label' => $name,
        'start' => isset($timer['start']) ? (float) $timer['start'] : 0,
        'duration' => isset($timer['duration']) ? (float) $timer['duration'] : 0,
        'collector' => 'time',
        'color' => isset($phaseColors[$name]) ? $phaseColors[$name] : '#66BB6A',
    ];
}

// 2) Database: tiap query menjadi measure dengan kategori "db".
$dbCount = 0;
$dbTime = 0;
if (class_exists('\System\Database')) {
    $queries = \System\Database::profile();
    if (is_array($queries)) {
        foreach ($queries as $q) {
            $dbCount++;
            $dur = isset($q['time']) ? (float) $q['time'] : 0;
            $dbTime += $dur;
            $sql = isset($q['sql']) ? preg_replace('/\s+/', ' ', trim($q['sql'])) : '';
            if (strlen($sql) > 60) {
                $sql = substr($sql, 0, 57) . '...';
            }
            $measures[] = [
                'label' => $sql,
                'start' => isset($q['start']) ? (float) $q['start'] : 0,
                'duration' => $dur,
                'collector' => 'db',
                'color' => '#5C6BC0',
            ];
        }
    }
}

// 3) View: tiap view yang dirender.
$views = Collectors::getData('views');
$views = isset($views['views']) ? $views['views'] : [];
foreach ($views as $view) {
    $measures[] = [
        'label' => isset($view['name']) ? $view['name'] : 'view',
        'start' => isset($view['start']) ? (float) $view['start'] : 0,
        'duration' => isset($view['time']) ? (float) $view['time'] : 0,
        'collector' => 'view',
        'color' => '#00897B',
    ];
}

// Urutkan berdasarkan waktu mulai (stabil).
usort($measures, function ($a, $b) {
    if ($a['start'] == $b['start']) {
        return 0;
    }
    return ($a['start'] < $b['start']) ? -1 : 1;
});

// Warna per kategori untuk pill kolektor pada tiap baris.
$collectorColors = ['time' => '#66BB6A', 'db' => '#5C6BC0', 'view' => '#00897B'];

$peakMem = memory_get_peak_usage(true) / 1048576; // MB
?>
