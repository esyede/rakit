<h1>Timeline</h1>

<div class="oops-inner oops-TimelinePanel">
    <div class="oops-inner-container">
        <?php if (empty($measures)) : ?>
            <p class="oops-empty">No measures recorded</p>
        <?php else : ?>
            <ul class="oops-tl-list">
                <?php foreach ($measures as $m) :
                    $start = $m['start'];
                    $duration = $m['duration'];
                    $left = max(0, min(100, ($start / $total) * 100));
                    $width = max(0.4, min(100 - $left, ($duration / $total) * 100));
                    $collector = $m['collector'];
                    $durText = ($duration > 0) ? number_format($duration, 2) . 'ms' : '';
                ?>
                    <li class="oops-tl-item">
                        <div class="oops-tl-measure" title="start @<?php echo number_format($start, 2) ?>ms&#10;<?php echo Helpers::escapeHtml($m['label']) ?>">
                            <span class="oops-tl-bar" style="left: <?php echo $left ?>%; width: <?php echo $width ?>%; background: <?php echo $m['color'] ?>;"></span>
                            <span class="oops-tl-collector" style="background: <?php echo isset($collectorColors[$collector]) ? $collectorColors[$collector] : '#888' ?>;"><?php echo Helpers::escapeHtml($collector) ?></span>
                            <span class="oops-tl-label"><b><?php echo Helpers::escapeHtml($m['label']) ?></b><?php if ('' !== $durText) : ?> <span class="oops-tl-dur">(<?php echo $durText ?>)</span><?php endif ?></span>
                        </div>
                    </li>
                <?php endforeach ?>
            </ul>

            <div class="oops-tl-summary">
                <span class="oops-tl-chip">Total <strong><?php echo number_format($total, 2) ?> ms</strong></span>
                <span class="oops-tl-chip">Database <strong><?php echo $dbCount ?></strong> <?php echo ($dbCount !== 1) ? 'queries' : 'query' ?> &middot; <strong><?php echo number_format($dbTime, 2) ?> ms</strong></span>
                <span class="oops-tl-chip">Views <strong><?php echo count($views) ?></strong></span>
                <span class="oops-tl-chip">Peak memory <strong><?php echo number_format($peakMem, 2) ?> MB</strong></span>
            </div>
        <?php endif ?>
    </div>
</div>
