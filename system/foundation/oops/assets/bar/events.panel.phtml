<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

$events = isset($this->data['events']) ? $this->data['events'] : array();
?>
<style class="oops-debug">
    #oops-debug .oops-EventsPanel td:first-child {
        font-weight: bold;
        font-family: Menlo, Monaco, Consolas, monospace;
        font-size: 11px;
        white-space: nowrap;
        vertical-align: top;
    }

    /* Payload: huruf kecil biar muat banyak, rapi & bisa di-scroll bila panjang */
    #oops-debug .oops-EventsPanel td pre {
        margin: 0;
        font-size: 10px;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 200px;
        overflow: auto;
    }
</style>

<h1>Hooks</h1>

<div class="oops-inner oops-EventsPanel">
    <div class="oops-inner-container">
        <?php if (empty($events)) : ?>
            <p class="oops-empty">No hooks fired</p>
        <?php else : ?>
            <table>
                <tr>
                    <th style="width: 35%;">Hook</th>
                    <th>Payload</th>
                </tr>
                <?php foreach ($events as $event) :
                    $name = isset($event['name']) ? $event['name'] : '(unknown)';
                    $payload = isset($event['data']) ? $event['data'] : array();
                ?>
                    <tr>
                        <td><?php echo Helpers::escapeHtml($name) ?></td>
                        <td>
                            <?php if (empty($payload)) : ?>
                                <span class="oops-empty">&mdash;</span>
                            <?php else : ?>
                                <pre><?php echo Helpers::escapeHtml(print_r($payload, true)) ?></pre>
                            <?php endif ?>
                        </td>
                    </tr>
                <?php endforeach ?>
            </table>
        <?php endif ?>
    </div>
</div>
