<h1>Exceptions</h1>

<div class="oops-inner oops-ExceptionsPanel">
    <div class="oops-inner-container">
        <?php if (empty($exceptions)) : ?>
            <p class="oops-empty">No exceptions were thrown</p>
        <?php else : ?>
            <?php foreach ($exceptions as $i => $ex) :
                $file = isset($ex['file']) ? $ex['file'] : '';
                $line = isset($ex['line']) ? $ex['line'] : 0;
                $editUri = Helpers::editorUri($file, $line ? $line : 1);
                $trace = isset($ex['trace']) ? $ex['trace'] : [];
                $occurred = isset($ex['count']) ? (int) $ex['count'] : 1;
            ?>
                <div class="oops-exc">
                    <div class="oops-exc-head">
                        <span class="oops-exc-class"><?php echo Helpers::escapeHtml($ex['class']) ?></span><?php if ($occurred > 1) : ?><span class="oops-exc-count" title="Thrown <?php echo $occurred ?> times">&times;<?php echo $occurred ?></span><?php endif ?>
                        <span class="oops-exc-msg"><?php echo Helpers::escapeHtml($ex['message']) ?></span>
                        <?php if ($file) : ?>
                            <span class="oops-exc-loc"><?php if ($editUri) : ?><a href="<?php echo Helpers::escapeHtml($editUri) ?>" title="Open in editor"><?php echo Helpers::escapeHtml($file . ($line ? ':' . $line : '')) ?></a><?php else : ?><?php echo Helpers::escapeHtml($file . ($line ? ':' . $line : '')) ?><?php endif ?></span>
                        <?php endif ?>
                    </div>
                    <?php if (!empty($trace)) : ?>
                        <?php $panelRef = 'exc-trace-' . $i; ?>
                        <p class="oops-exc-toggle"><a class="oops-toggle oops-collapsed" data-oops-ref="^div .<?php echo $panelRef ?>">Stack trace (<?php echo count($trace) ?>)</a></p>
                        <div class="<?php echo $panelRef ?> oops-collapsed">
                            <ul class="oops-exc-trace">
                                <?php foreach ($trace as $frame) :
                                    $fn = (isset($frame['class']) ? $frame['class'] : '') . (isset($frame['type']) ? $frame['type'] : '') . (isset($frame['function']) ? $frame['function'] : '') . '()';
                                    $ffile = isset($frame['file']) ? $frame['file'] : null;
                                    $fline = isset($frame['line']) ? $frame['line'] : null;
                                    $frameUri = $ffile ? Helpers::editorUri($ffile, $fline ? $fline : 1) : null;
                                ?>
                                    <li>
                                        <span class="oops-exc-fn"><?php echo Helpers::escapeHtml($fn) ?></span>
                                        <?php if ($ffile) : ?>
                                            <span class="oops-exc-frameloc">&mdash; <?php if ($frameUri) : ?><a href="<?php echo Helpers::escapeHtml($frameUri) ?>" title="Open in editor"><?php echo Helpers::escapeHtml($shortLoc($ffile, $fline)) ?></a><?php else : ?><?php echo Helpers::escapeHtml($shortLoc($ffile, $fline)) ?><?php endif ?></span>
                                        <?php else : ?>
                                            <span class="oops-exc-frameloc">&mdash; <i>internal</i></span>
                                        <?php endif ?>
                                    </li>
                                <?php endforeach ?>
                            </ul>
                        </div>
                    <?php endif ?>
                </div>
            <?php endforeach ?>
        <?php endif ?>
    </div>
</div>
