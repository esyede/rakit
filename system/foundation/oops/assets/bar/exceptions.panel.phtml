<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

$exceptions = isset($this->data['exceptions']) ? $this->data['exceptions'] : [];

// "path/to/file.php" + line -> "file.php:line" untuk label ringkas.
$shortLoc = function ($file, $line) {
    if (!$file) {
        return '';
    }
    return basename($file) . ($line ? ':' . $line : '');
};
?>
