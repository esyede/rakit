<h1>Deprecations</h1>

<div class="oops-inner oops-DeprecationsPanel">
    <div class="oops-inner-container oops-filterable">
        <?php if (empty($deprecations)) : ?>
            <p class="oops-empty">No deprecation notices</p>
        <?php else : ?>
            <ul class="oops-dep-list">
                <?php foreach ($deprecations as $dep) :
                    $message = isset($dep['message']) ? $dep['message'] : '';
                    $file = isset($dep['file']) ? $dep['file'] : '';
                    $line = isset($dep['line']) ? $dep['line'] : 0;
                    $type = isset($dep['type']) ? $dep['type'] : 'E_DEPRECATED';
                    $occurred = isset($dep['count']) ? (int) $dep['count'] : 1;
                    $editUri = $file ? Helpers::editorUri($file, $line ? $line : 1) : null;
                    $loc = $file ? (basename($file) . ($line ? ':' . $line : '')) : '';
                    $search = strtolower($message . ' ' . $type . ' ' . $loc);
                ?>
                    <li class="oops-dep oops-filter-item" data-oops-tag="<?php echo Helpers::escapeHtml(strtolower($type)) ?>" data-oops-search="<?php echo Helpers::escapeHtml($search) ?>">
                        <span class="oops-dep-msg"><?php echo Helpers::escapeHtml($message) ?><?php if ($occurred > 1) : ?><span class="oops-dep-count" title="Reported <?php echo $occurred ?> times">&times;<?php echo $occurred ?></span><?php endif ?></span>
                        <span class="oops-dep-meta">
                            <span class="oops-dep-type"><?php echo Helpers::escapeHtml($type) ?></span>
                            <?php if ($loc) : ?>
                                &middot; <span class="oops-dep-loc" title="<?php echo Helpers::escapeHtml($file . ($line ? ':' . $line : '')) ?>"><?php if ($editUri) : ?><a href="<?php echo Helpers::escapeHtml($editUri) ?>"><?php echo Helpers::escapeHtml($loc) ?></a><?php else : ?><?php echo Helpers::escapeHtml($loc) ?><?php endif ?></span>
                            <?php endif ?>
                        </span>
                    </li>
                <?php endforeach ?>
                <li class="oops-empty oops-filter-empty" style="display: none; list-style: none; padding: 10px;">No deprecations match your filter.</li>
            </ul>

            <div class="oops-toolbar">
                <input type="text" class="oops-filter-input" placeholder="Search deprecations&hellip;" spellcheck="false" autocomplete="off">
                <span class="oops-filter-count"></span>
            </div>
        <?php endif ?>
    </div>
</div>
