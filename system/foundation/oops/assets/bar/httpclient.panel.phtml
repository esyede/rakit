<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

$requests = isset($this->data['http']) ? $this->data['http'] : [];

$statusGroup = function ($status) {
    if ($status >= 200 && $status < 300) {
        return 'success';
    }
    if ($status >= 300 && $status < 400) {
        return 'redirect';
    }
    if ($status >= 400) {
        return 'error';
    }
    return 'other';
};

$formatBytes = function ($bytes) {
    $bytes = (int) $bytes;
    if ($bytes < 1024) {
        return $bytes . ' B';
    }
    if ($bytes < 1048576) {
        return number_format($bytes / 1024, 1) . ' KB';
    }
    return number_format($bytes / 1048576, 2) . ' MB';
};

$totalTime = 0;
foreach ($requests as $r) {
    $totalTime += isset($r['duration']) ? $r['duration'] : 0;
}

// Bangun perintah cURL yang bisa disalin untuk mereproduksi request.
$buildCurl = function ($r) {
    $method = isset($r['method']) ? $r['method'] : 'GET';
    $url = isset($r['url']) ? $r['url'] : '';
    $parts = ['curl'];

    if ('GET' !== $method) {
        $parts[] = '-X ' . $method;
    }

    if (!empty($r['headers']) && is_array($r['headers'])) {
        foreach ($r['headers'] as $name => $value) {
            if (is_int($name)) {
                $header = (string) $value; // sudah berformat "Name: value"
            } else {
                $header = $name . ': ' . $value;
            }
            $parts[] = '-H ' . escapeshellarg($header);
        }
    }

    if (isset($r['body']) && is_string($r['body']) && '' !== $r['body']) {
        $body = $r['body'];
        if (strlen($body) > 2048) {
            $body = substr($body, 0, 2048);
        }
        $parts[] = '--data ' . escapeshellarg($body);
    }

    $parts[] = escapeshellarg($url);

    return implode(' ', $parts);
};
