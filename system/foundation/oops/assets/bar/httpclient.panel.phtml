                    $url = isset($r['url']) ? $r['url'] : '';
                    $status = isset($r['status']) ? (int) $r['status'] : 0;
                    $group = $statusGroup($status);
                    $error = isset($r['error']) ? $r['error'] : null;
                    $search = strtolower($method . ' ' . $url . ' ' . $status);
                ?>
                    <li class="oops-http-item oops-filter-item" data-oops-tag="<?php echo Helpers::escapeHtml(strtolower($method)) ?>" data-oops-search="<?php echo Helpers::escapeHtml($search) ?>">
                        <span class="oops-http-method"><?php echo Helpers::escapeHtml($method) ?></span>
                        <span class="oops-http-code oops-http-code-<?php echo $group ?>"><?php echo $status ? $status : '—' ?></span>
                        <span class="oops-http-url">
                            <?php echo Helpers::escapeHtml($url) ?>
                            <?php if ($error) : ?><span class="oops-http-err"> &mdash; <?php echo Helpers::escapeHtml($error) ?></span><?php endif ?>
                        </span>
                        <a class="oops-http-curl" title="Copy as cURL" data-oops-copy="<?php echo Helpers::escapeHtml($buildCurl($r)) ?>">&#8862; cURL</a>
                        <span class="oops-http-size"><?php echo $formatBytes(isset($r['size']) ? $r['size'] : 0) ?></span>
                        <span class="oops-http-dur"><?php echo number_format(isset($r['duration']) ? $r['duration'] : 0, 2) ?> ms</span>
                    </li>
                <?php endforeach ?>
                <li class="oops-empty oops-filter-empty" style="display: none; list-style: none; padding: 10px;">No requests match your filter.</li>
            </ul>

            <div class="oops-toolbar">
                <input type="text" class="oops-filter-input" placeholder="Search requests&hellip;" spellcheck="false" autocomplete="off">
                <span class="oops-filter-count"></span>
