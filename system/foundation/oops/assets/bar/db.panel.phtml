<?php

namespace System\Foundation\Oops;

defined('DS') or exit('No direct access.');

use System\Database;

$queries = Database::profile();

// Ringkasan: total waktu + deteksi query duplikat (SQL + bindings identik).
$totalTime = 0;
$signatures = [];
foreach ($queries as $idx => $query) {
    $totalTime += isset($query['time']) ? (float) $query['time'] : 0;
    $sig = (isset($query['sql']) ? $query['sql'] : '')
        . '|' . serialize(isset($query['bindings']) ? $query['bindings'] : []);
    if (!isset($signatures[$sig])) {
        $signatures[$sig] = [];
    }
    $signatures[$sig][] = $idx;
}

$dupOccurrences = [];
$dupTotal = 0;
foreach ($signatures as $idxs) {
    if (count($idxs) > 1) {
        foreach ($idxs as $ix) {
            $dupOccurrences[$ix] = count($idxs);
        }
        $dupTotal += count($idxs);
    }
}
$uniqueCount = count($queries) - $dupTotal;

// Nama koneksi default (laravel-debugbar menampilkan koneksi tiap query).
$connName = 'default';
try {
    if (function_exists('config')) {
        $connName = (string) config('database.default', 'default');
    }
} catch (\Throwable $e) {
    // abaikan
} catch (\Exception $e) {
    // abaikan
}

// Ubah "path/ke/file.php:22" menjadi "file.php#22" (gaya laravel).
$shortCaller = function ($source) {
    if (!$source) {
        return '';
    }
    if (preg_match('#([^/\\\\]+):(\d+)$#', $source, $m)) {
        return $m[1] . '#' . $m[2];
    }
    return basename($source);
};
