--- a/src/Token.php
+++ b/src/Token.php
@@ -819,6 +819,29 @@
 class PHP_Token_SPACESHIP extends PHP_Token {}
 class PHP_Token_YIELD_FROM extends PHP_Token {}
 
+// Tokens introduced in PHP 8.0 - 8.4
+//
+// New PHP versions keep adding tokens, and this library maps every token to a
+// class named after it. Any token without a class here is resolved to
+// PHP_Token_UNKNOWN by PHP_Token_Stream::scan(), so scanning modern sources no
+// longer aborts with "Class ... not found". The known ones are still declared
+// explicitly so they keep their own identity.
+class PHP_Token_UNKNOWN extends PHP_Token {}
+class PHP_Token_NAME_QUALIFIED extends PHP_Token {}
+class PHP_Token_NAME_FULLY_QUALIFIED extends PHP_Token {}
+class PHP_Token_NAME_RELATIVE extends PHP_Token {}
+class PHP_Token_ATTRIBUTE extends PHP_Token {}
+class PHP_Token_MATCH extends PHP_Token {}
+class PHP_Token_FN extends PHP_Token {}
+class PHP_Token_COALESCE_EQUAL extends PHP_Token {}
+class PHP_Token_READONLY extends PHP_Token {}
+class PHP_Token_AMPERSAND_FOLLOWED_BY_VAR_OR_VARARG extends PHP_Token {}
+class PHP_Token_AMPERSAND_NOT_FOLLOWED_BY_VAR_OR_VARARG extends PHP_Token {}
+class PHP_Token_PUBLIC_SET extends PHP_Token {}
+class PHP_Token_PROTECTED_SET extends PHP_Token {}
+class PHP_Token_PRIVATE_SET extends PHP_Token {}
+class PHP_Token_PROPERTY_C extends PHP_Token {}
+
 // Tokens introduced in HackLang / HHVM
 class PHP_Token_ASYNC extends PHP_Token {}
 class PHP_Token_AWAIT extends PHP_Token {}
